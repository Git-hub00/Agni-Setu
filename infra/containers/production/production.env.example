# Agni Setu - application environment for the production-shaped stack (AGNI_ENV_FILE).
# Render this file from the approved secret store onto the operator host (mode 0600); never
# commit a populated copy. config.settings.production refuses to start while any <...>
# placeholder, wildcard host, http:// CSRF origin, short secret or demo sink remains (LIVE).
# Values below are placeholders, not defaults. docs/10 s.6 lists the contract; docs/19 the gates.

APP_ENV=production
# DEMO for the approved demonstration deployment; LIVE only after every docs/19 s.2 decision.
SERVICE_MODE=DEMO
DJANGO_SECRET_KEY=<50+ random characters from the secret store>

# Supported PostgreSQL 17 service (TLS, dedicated role, no superuser). Tests never use it.
DATABASE_URL=postgresql://<role>:<password>@<host>:5432/<database>?sslmode=verify-full
# Broker and cache (authenticated; private network only; management UIs never public).
CELERY_BROKER_URL=amqps://<user>:<password>@<host>:5671/<vhost>
CACHE_URL=rediss://:<password>@<host>:6380/0

# Independent application secrets (each >= 32 characters, generated separately).
OTP_PEPPER=<independent secret>
CONTACT_LOOKUP_KEY=<independent secret>
DATA_ENCRYPTION_KEY=<independent secret>
DATA_ENCRYPTION_KEY_REF=<managed key reference>

# Private S3-compatible object service (ADR-08): versioned bucket, no public access.
OBJECT_STORE_PROVIDER=s3
OBJECT_ENDPOINT=https://<object-service>
OBJECT_REGION=<region>
OBJECT_BUCKET=<private-bucket>
OBJECT_ACCESS_KEY=<access key id>
OBJECT_SECRET_KEY=<secret>

# Staff identity provider (OIDC, MFA enforced at the provider).
OIDC_ISSUER=https://<issuer>/realms/<realm>
OIDC_CLIENT_ID=<client id>
OIDC_CLIENT_SECRET=<client secret>

# Same-origin browser configuration: the public https origin served by the TLS proxy.
PUBLIC_ORIGIN=https://<public-host>
CSRF_TRUSTED_ORIGINS=https://<public-host>
# `api` is the internal service name used by the web proxy; 127.0.0.1 serves the container's own
# readiness probe. No wildcard.
ALLOWED_HOSTS=<public-host>,api,127.0.0.1
PUBLIC_VERIFY_BASE_URL=https://<public-host>/verify
TRUST_X_FORWARDED_FOR=true
SECURE_HSTS_SECONDS=31536000

# Provider adapters. DEMO may keep demo sinks (nothing is sent); LIVE requires approved adapters
# and refuses demo_sink / demo_watermark / demo scanner values.
OTP_PROVIDER=demo_sink
NOTIFICATION_PROVIDER=demo_sink
SIGNING_PROVIDER=demo_watermark
SCANNER_PROVIDER=clamav
SCANNER_HOST=<scanner-host>
SCANNER_PORT=3310

# Never true in a deployed environment (demo reset / inbox routes are not registered).
ENABLE_DEMO_CONTROLS=false
# Partner intake secrets come from the secret store; the simulator secret is refused in LIVE.
INTEGRATION_DEMO_SECRETS=
LOG_LEVEL=INFO
