# Agni Setu backend environment contract (docs/10_BUILD_GUIDE.md s.6).
# Copy to backend/.env for local development. Every <...> value is a secret to GENERATE
# locally (scripts/dev/doctor.sh and up.sh will do this at B01); never paste real
# production values here or commit a populated .env. Production supplies these through the
# approved secret store and uses config.settings.production, which refuses defaults.

APP_ENV=local
# DEMO or LIVE. LIVE startup rejects demo sinks, sample signer, DEBUG and demo controls.
SERVICE_MODE=DEMO
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=<generated-local-secret>

# PostgreSQL 17 is the only supported database. Automated tests use TEST_DATABASE_NAME,
# never the developer database.
DATABASE_URL=postgresql://agni_app:<generated>@127.0.0.1:5432/agni_dev
TEST_DATABASE_NAME=agni_test

# Celery transport (RabbitMQ) and disposable cache / rate-limit store (Valkey).
CELERY_BROKER_URL=amqp://agni_worker:<generated>@127.0.0.1:5672/agni_dev
CACHE_URL=redis://:<generated>@127.0.0.1:6379/0

# Independent secrets: OTP hashing pepper and blind contact-lookup key.
OTP_PEPPER=<generated-independent-secret>
CONTACT_LOOKUP_KEY=<generated-independent-secret>
DATA_ENCRYPTION_KEY_REF=<local-secret-reference>

# Private S3-compatible object storage. Local default is the loopback SeaweedFS emulator
# with explicit credentials; it is never a production storage service (ADR-08).
OBJECT_ENDPOINT=http://127.0.0.1:8333
OBJECT_REGION=local
OBJECT_BUCKET=agni-dev-private
OBJECT_ACCESS_KEY=<generated-local-id>
OBJECT_SECRET_KEY=<generated-local-secret>

# Staff OIDC. Local Keycloak (full profile) issuer; production uses the approved HTTPS issuer.
OIDC_ISSUER=http://localhost:8080/realms/agni-dev
OIDC_CLIENT_ID=agni-web
OIDC_CLIENT_SECRET=<generated-local-client-secret>

# Same-origin browser configuration.
PUBLIC_ORIGIN=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=127.0.0.1,localhost

# Provider adapters. demo_sink / demo_watermark are local sinks; they send nothing real.
OTP_PROVIDER=demo_sink
NOTIFICATION_PROVIDER=demo_sink
SIGNING_PROVIDER=demo_watermark
SCANNER_PROVIDER=clamav

# Demo reset/fault controls are registered only when APP_ENV and SERVICE_MODE permit.
ENABLE_DEMO_CONTROLS=true
LOG_LEVEL=INFO
