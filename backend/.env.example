# Agni Setu environment contract (docs/10_BUILD_GUIDE.md s.6).
#
# `scripts/dev/up.sh` copies this file to the repository-root `.env.local` (gitignored) and replaces
# every <...> placeholder with a freshly generated random secret, then rewrites DATABASE_URL,
# CELERY_BROKER_URL and CACHE_URL from the discrete credentials below so they stay consistent.
# Never commit a populated .env. Production supplies these values through the approved secret
# store and uses config.settings.production, which refuses placeholders and demo sinks.

APP_ENV=local
# DEMO or LIVE. LIVE startup rejects demo sinks, sample signer, DEBUG and demo controls.
SERVICE_MODE=DEMO
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=<generated-local-secret>

# ---- PostgreSQL 17 (the only supported database, ADR-02) -------------------------------
# Compose publishes the container on 127.0.0.1:${POSTGRES_HOST_PORT}; 5432 is often taken by a
# host PostgreSQL, so the default is 55432. Automated tests use TEST_DATABASE_NAME.
POSTGRES_USER=agni_app
POSTGRES_PASSWORD=<generated>
POSTGRES_DB=agni_dev
POSTGRES_HOST_PORT=55432
DATABASE_URL=postgresql://agni_app:<generated>@127.0.0.1:55432/agni_dev
TEST_DATABASE_NAME=agni_test

# ---- RabbitMQ 4 (Celery transport, ADR-07) ---------------------------------------------
RABBITMQ_USER=agni_worker
RABBITMQ_PASSWORD=<generated>
RABBITMQ_VHOST=agni_dev
CELERY_BROKER_URL=amqp://agni_worker:<generated>@127.0.0.1:5672/agni_dev

# ---- Valkey 8.1 (disposable cache / rate-limit store, ADR-07) ---------------------------
VALKEY_PASSWORD=<generated>
CACHE_URL=redis://:<generated>@127.0.0.1:6379/0

# ---- Independent application secrets ---------------------------------------------------
OTP_PEPPER=<generated-independent-secret>
CONTACT_LOOKUP_KEY=<generated-independent-secret>
DATA_ENCRYPTION_KEY_REF=<local-secret-reference>

# ---- Private S3-compatible object storage (ADR-08) --------------------------------------
# Local default is the loopback SeaweedFS emulator with explicit credentials; never production.
OBJECT_ENDPOINT=http://127.0.0.1:8333
OBJECT_REGION=local
OBJECT_BUCKET=agni-dev-private
OBJECT_ACCESS_KEY=<generated-local-id>
OBJECT_SECRET_KEY=<generated-local-secret>

# ---- Staff OIDC (local Keycloak in the `full` Compose profile) -------------------------
OIDC_ISSUER=http://localhost:8080/realms/agni-dev
OIDC_CLIENT_ID=agni-web
OIDC_CLIENT_SECRET=<generated-local-client-secret>
KC_BOOTSTRAP_ADMIN_USERNAME=agni_kc_admin
KC_BOOTSTRAP_ADMIN_PASSWORD=<generated>

# ---- Same-origin browser configuration -------------------------------------------------
PUBLIC_ORIGIN=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=127.0.0.1,localhost
WEB_HOST_PORT=5173

# ---- Provider adapters (demo sinks send nothing real) ----------------------------------
OTP_PROVIDER=demo_sink
NOTIFICATION_PROVIDER=demo_sink
SIGNING_PROVIDER=demo_watermark
SCANNER_PROVIDER=clamav

# Demo reset/fault controls are registered only when APP_ENV and SERVICE_MODE permit.
ENABLE_DEMO_CONTROLS=true
LOG_LEVEL=INFO
GUNICORN_WORKERS=2
