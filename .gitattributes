# Normalise line endings: LF in the repository, LF in every checkout (Windows + macOS + Linux
# containers). Shell scripts and lockfiles must never be CRLF-converted.
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
uv.lock text eol=lf
pnpm-lock.yaml text eol=lf

# Windows-only helpers keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.woff2 binary
*.pdf binary
